{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "compressor.pratix.io"
        }
      ],
      "destination": "https://pratix.io/compressor/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "prompter.pratix.io"
        }
      ],
      "destination": "https://pratix.io/prompter/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "revenue.pratix.io"
        }
      ],
      "destination": "https://pratix.io/revenue/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ads.pratix.io"
        }
      ],
      "destination": "https://pratix.io/ads/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cleaner.pratix.io"
        }
      ],
      "destination": "https://pratix.io/cleaner/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "schema.pratix.io"
        }
      ],
      "destination": "https://pratix.io/schema/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "studio.pratix.io"
        }
      ],
      "destination": "https://pratix.io/commerce-studio/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pdf-editor.pratix.io"
        }
      ],
      "destination": "https://pratix.io/pdf-editor/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/compressor/:path*",
      "destination": "https://compressor-murex.vercel.app/:path*"
    },
    {
      "source": "/prompter/:path*",
      "destination": "https://prompter-wine-three.vercel.app/:path*"
    },
    {
      "source": "/revenue/:path*",
      "destination": "https://revenue-khaki-seven.vercel.app/:path*"
    },
    {
      "source": "/ads/:path*",
      "destination": "https://banner-placeholder-generator.vercel.app/:path*"
    },
    {
      "source": "/cleaner/:path*",
      "destination": "https://excel-data-cleaner-iota.vercel.app/:path*"
    },
    {
      "source": "/schema/:path*",
      "destination": "https://schema-generator-one.vercel.app/:path*"
    },
    {
      "source": "/commerce-studio/:path*",
      "destination": "https://pratix-commerce-studio.vercel.app/:path*"
    },
    {
      "source": "/pdf-editor/:path*",
      "destination": "https://pdf-editor-six-rose.vercel.app/:path*"
    }
  ]
