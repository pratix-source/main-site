{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "compressor.pratix.io" }
      ],
      "destination": "https://www.pratix.io/compressor/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "prompter.pratix.io" }
      ],
      "destination": "https://www.pratix.io/prompter/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "revenue.pratix.io" }
      ],
      "destination": "https://www.pratix.io/revenue/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "ads.pratix.io" }
      ],
      "destination": "https://www.pratix.io/ads/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "cleaner.pratix.io" }
      ],
      "destination": "https://www.pratix.io/cleaner/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "schema.pratix.io" }
      ],
      "destination": "https://www.pratix.io/schema/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/compressor",
      "destination": "https://compressor-murex.vercel.app"
    },
    {
      "source": "/compressor/(.*)",
      "destination": "https://compressor-murex.vercel.app/$1"
    },
    {
      "source": "/prompter",
      "destination": "https://prompter-wine-three.vercel.app"
    },
    {
      "source": "/prompter/(.*)",
      "destination": "https://prompter-wine-three.vercel.app/$1"
    }
  ]
}
